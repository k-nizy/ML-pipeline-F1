// =============================================================================
//  Beijing PM2.5 pipeline - entity relationship diagram
//  Paste this file into https://dbdiagram.io/d  ->  Export PNG -> sql/erd.png
//  Kept in the repo so the diagram is regenerable instead of a lost screenshot.
// =============================================================================

Enum wind_direction {
  N
  NNE
  NE
  ENE
  E
  ESE
  SE
  SSE
  S
  SSW
  SW
  WSW
  W
  WNW
  NW
  NNW
  CV
}

// Dimension: one row per monitoring site.
Table stations {
  station_id   int          [pk, increment]
  station_name varchar(100) [not null, unique]
  city         varchar(100) [not null]
  country      varchar(60)  [not null, default: 'China']
  latitude     decimal(9,6) [not null]
  longitude    decimal(9,6) [not null]
  timezone     varchar(40)  [not null, default: 'Asia/Shanghai']
  description  varchar(255)
  created_at   datetime     [not null, default: `CURRENT_TIMESTAMP`]

  Note: 'Beijing US Embassy monitor; weather columns come from Beijing Capital Airport.'
}

// Fact: one row per station per hour (43,824 rows).
Table readings {
  reading_id  bigint       [pk, increment]
  station_id  int          [not null, ref: > stations.station_id]
  observed_at datetime     [not null, note: 'hourly grain, minute/second = 00']
  pm25        decimal(7,2) [note: 'TARGET in ug/m3, NULL = sensor gap']
  dewp        decimal(5,2)
  temp        decimal(5,2)
  pres        decimal(7,2)
  wind_dir    wind_direction
  wind_speed  decimal(5,2)
  snow_hours  smallint     [not null, default: 0]
  rain_hours  smallint     [not null, default: 0]
  is_imputed  tinyint      [not null, default: 0]
  ingested_at datetime     [not null, default: `CURRENT_TIMESTAMP`]
  updated_at  datetime     [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
    (station_id, observed_at) [unique, name: 'uq_readings_station_hour']
    observed_at               [name: 'idx_readings_observed_at']
    pm25                      [name: 'idx_readings_pm25']
  }
}

// Derived: one row per station per day (1,826 rows), feeds lags and moving averages.
Table daily_aggregates {
  agg_id         bigint       [pk, increment]
  station_id     int          [not null, ref: > stations.station_id]
  agg_date       date         [not null]
  pm25_avg       decimal(7,2)
  pm25_max       decimal(7,2)
  pm25_min       decimal(7,2)
  pm25_std       decimal(7,2)
  pm25_count     smallint     [not null, default: 0, note: 'hours with a real value (24 = complete)']
  readings_count smallint     [not null, default: 0]
  temp_avg       decimal(5,2)
  pres_avg       decimal(7,2)
  refreshed_at   datetime     [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
    (station_id, agg_date) [unique, name: 'uq_daily_station_date']
    agg_date [name: 'idx_daily_date']
  }
}

// Model registry (Task 1).
Table models {
  model_id      int          [pk, increment]
  model_name    varchar(100) [not null, unique]
  model_type    varchar(50)  [not null, note: 'linear_regression | random_forest | lstm']
  feature_set   json
  hyperparams   json
  artifact_path varchar(255) [not null]
  trained_at    datetime     [not null]
  notes         text
}

// One row per experiment, carrying its test metrics -> the experiment table.
Table forecast_runs {
  run_id           int          [pk, increment]
  model_id         int          [not null, ref: > models.model_id]
  experiment_label varchar(60)  [not null, note: 'Experiment A / B ...']
  run_at           datetime     [not null, default: `CURRENT_TIMESTAMP`]
  horizon_hours    smallint     [not null, default: 1]
  train_start      date
  train_end        date
  test_start       date
  test_end         date
  rmse             decimal(8,3)
  mae              decimal(8,3)
  r2               decimal(7,4)
  notes            varchar(255)

  indexes {
    (model_id, experiment_label) [unique, name: 'uq_runs_model_label']
  }
}

// Predicted vs actual per forecasted hour (Task 4 output).
Table forecast_predictions {
  prediction_id  bigint       [pk, increment]
  run_id         int          [not null, ref: > forecast_runs.run_id]
  target_time    datetime     [not null]
  predicted_pm25 decimal(7,2) [not null]
  actual_pm25    decimal(7,2) [note: 'NULL for future hours']
  abs_error      decimal(8,2) [note: 'generated column = ABS(predicted - actual)']

  indexes {
    (run_id, target_time) [unique, name: 'uq_predictions_run_target']
    target_time [name: 'idx_predictions_target_time']
  }
}
