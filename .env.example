# Copy this file to .env and fill in your own values.  Never commit .env.

# ---- MySQL (local dev) ----
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=beijing_air

# ---- MongoDB Atlas (owned by the MongoDB lead) ----
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGO_DATABASE=beijing_air
MONGO_COLLECTION=readings

# ---- API ----
API_HOST=127.0.0.1
API_PORT=8000
